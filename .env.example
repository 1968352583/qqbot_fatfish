# QQ 官方机器人凭据；复制为 .env.local 或运行本机配置向导。
QQ_APP_ID=
QQ_APP_SECRET=

# 首期模型和管理员登录；请勿提交真实配置。
DEEPSEEK_API_KEY=
ADMIN_PASSWORD=

# 可选：百炼北京地域 API Key；业务空间与音色在管理员后台设置。
# DASHSCOPE_API_KEY=
# 可选：通用云端语音接口密钥。
# TTS_API_KEY=
# DATA_DIR=.local/app
# HOST=127.0.0.1
# PORT=3210
# 公网 IP HTTPS 入口；安装脚本会将这两项写入服务器环境配置。
# 完整来源地址无末尾斜杠；应用仍须监听 127.0.0.1，由本机 Nginx 反代。
# ADMIN_ORIGIN=https://8.130.14.159
# ADMIN_TRUST_PROXY=1
